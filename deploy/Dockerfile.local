FROM ubuntu:22.04

# Install SSH server, git, node, npm, rsync, sudo, nginx
RUN apt-get update && apt-get install -y \
    openssh-server \
    git \
    curl \
    rsync \
    sudo \
    nginx \
    bash \
    && rm -rf /var/lib/apt/lists/*

# Install Node 22
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Create deploy user
RUN useradd -m -s /bin/bash deploy \
    && usermod -aG sudo deploy \
    && echo 'deploy ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers

# Setup SSH
RUN mkdir -p /run/sshd \
    && mkdir -p /home/deploy/.ssh

# Accept any SSH key (for local testing only - not secure)
COPY deploy/authorized_keys.local /home/deploy/.ssh/authorized_keys
RUN chmod 700 /home/deploy/.ssh \
    && chmod 600 /home/deploy/.ssh/authorized_keys \
    && chown -R deploy:deploy /home/deploy/.ssh

# SSH config for local testing
RUN echo "PermitRootLogin no" >> /etc/ssh/sshd_config \
    && echo "PubkeyAuthentication yes" >> /etc/ssh/sshd_config \
    && ssh-keygen -A

# Provide a tiny systemctl shim for containers without systemd.
RUN printf '%s\n' '#!/bin/sh' \
    'if [ "$1" = "reload" ] && [ "$2" = "nginx" ]; then' \
    '  nginx -s reload 2>/dev/null || nginx' \
    '  exit 0' \
    'fi' \
    'echo "Unsupported systemctl command: $*" >&2' \
    'exit 1' \
    > /usr/local/bin/systemctl \
    && chmod +x /usr/local/bin/systemctl

EXPOSE 22

CMD ["/bin/bash", "-lc", "nginx && exec /usr/sbin/sshd -D"]

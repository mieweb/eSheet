{
  "name": "@esheet/demo",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "prebuild": "pnpm --filter @esheet/styles build",
    "build": "vite build",
    "build:dist": "pnpm --filter './packages/**' --recursive --if-present build && ESHEET_USE_DIST=true vite build",
    "predev": "pnpm --filter @esheet/styles build",
    "dev": "vite",
    "dev:dist": "pnpm --filter './packages/**' --recursive --if-present build && ESHEET_USE_DIST=true vite",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --build --emitDeclarationOnly --force"
  },
  "dependencies": {
    "@esheet/adapters": "workspace:*",
    "@esheet/builder": "workspace:*",
    "@esheet/core": "workspace:*",
    "@esheet/field-health": "workspace:*",
    "@esheet/field-kerebron": "workspace:*",
    "@esheet/fields": "workspace:*",
    "@esheet/fields-documents": "workspace:*",
    "@esheet/renderer": "workspace:*",
    "@kerebron/wasm": "^0.8.10",
    "@mieweb/ui": "0.7.3",
    "js-yaml": "^5.2.3",
    "lucide-react": "^1.31.0",
    "mermaid": "^11.16.1",
    "papaparse": "^5.5.4",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9"
  }
}

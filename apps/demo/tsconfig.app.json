{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "jsx": "react-jsx",
    "lib": ["dom"],
    "types": [
      "node",
      "react",
      "react-dom",
      "@nx/react/typings/cssmodule.d.ts",
      "@nx/react/typings/image.d.ts",
      "vite/client"
    ],
    "rootDir": "src",
    "module": "esnext",
    "moduleResolution": "bundler",
    "customConditions": ["@esheet/source"],
    "paths": {
      "@esheet/builder": ["../../packages/builder/src/index.ts"],
      "@esheet/renderer": ["../../packages/renderer/src/index.ts"],
      "@esheet/core": ["../../packages/core/src/index.ts"],
      "@esheet/fields": ["../../packages/fields/src/index.ts"],
      "@esheet/adapters": ["../../packages/adapters/src/index.ts"]
    }
  },
  "exclude": [
    "out-tsc",
    "dist",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.tsx",
    "src/**/*.test.tsx",
    "src/**/*.spec.js",
    "src/**/*.test.js",
    "src/**/*.spec.jsx",
    "src/**/*.test.jsx",
    "eslint.config.js",
    "eslint.config.cjs",
    "eslint.config.mjs"
  ],
  "include": ["src/**/*.js", "src/**/*.jsx", "src/**/*.ts", "src/**/*.tsx"],
  "references": [
    {
      "path": "../../packages/renderer/tsconfig.lib.json"
    },
    {
      "path": "../../packages/fields/tsconfig.lib.json"
    },
    {
      "path": "../../packages/field-kerebron/tsconfig.lib.json"
    },
    {
      "path": "../../packages/field-health/tsconfig.lib.json"
    },
    {
      "path": "../../packages/core/tsconfig.lib.json"
    },
    {
      "path": "../../packages/builder/tsconfig.lib.json"
    },
    {
      "path": "../../packages/adapters/tsconfig.lib.json"
    }
  ]
}

          ]
        },
        {
          "id": "section-nested",
          "fieldType": "section",
          "title": "6 — Nested Functions (diffDays + addDays)",
          "fields": [
            {
              "id": "baseline-date",
              "fieldType": "text",
              "question": "Baseline Date",
              "inputType": "date",
              "required": true
            },
            {
              "id": "offset-days",
              "fieldType": "text",
              "question": "Offset Days",
              "inputType": "number",
              "required": true
            },
            {
              "id": "target-date",
              "fieldType": "text",
              "question": "Target Date",
              "inputType": "date",
              "required": true
            },
            {
              "id": "nested-result",
              "fieldType": "display",
              "content": "**Baseline + offset:** <addDays({baseline-date}, {offset-days})>\n\n**Days from (baseline + offset) to target:** <diffDays({target-date}, addDays({baseline-date}, {offset-days}))>",
              "rules": [
                {
                  "effect": "visible",
                  "logic": "AND",
                  "conditions": [
                    {
                      "conditionType": "expression",
                      "expression": "{baseline-date} !== '' && {offset-days} !== '' && {target-date} !== ''"
                    }
                  ]
                }
              ]
            },
            {
              "id": "nested-match",
              "fieldType": "display",
              "content": "✅ Target date exactly matches baseline + offset.",
              "rules": [
                {
                  "effect": "visible",
                  "logic": "AND",
                  "conditions": [
                    {
                      "conditionType": "expression",
                      "expression": "{baseline-date} !== '' && {offset-days} !== '' && {target-date} !== '' && diffDays({target-date}, addDays({baseline-date}, {offset-days})) === 0"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}

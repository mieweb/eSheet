              "inputType": "date",
              "required": true
            },
            {
              "id": "nested-result",
              "fieldType": "display",
              "content": "**Baseline + offset:** \u003caddDays({baseline-date}, {offset-days})\u003e\n\n**Days from (baseline + offset) to target:** \u003cdiffDays({target-date}, addDays({baseline-date}, {offset-days}))\u003e",
              "rules": [
                {
                  "effect": "visible",
                  "logic": "AND",
                  "conditions": [

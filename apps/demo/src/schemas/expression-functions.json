{
  "id": "expression-functions",
  "title": "Expression Functions Test Suite",
  "pages": [
    {
      "id": "page-1",
      "fields": [
        {
          "id": "intro",
          "fieldType": "html",
          "htmlContent": "<h2 style='margin:0 0 8px'>Expression Functions Test Suite</h2><p>Demonstrates the built-in expression engine functions: <strong>date arithmetic</strong> (<code>addDays</code>, <code>subDays</code>, <code>diffDays</code>, <code>today</code>, <code>year</code>), <strong>numeric helpers</strong> (<code>min</code>, <code>max</code>, <code>round</code>, <code>floor</code>, <code>ceil</code>, <code>abs</code>), and <strong>conditional</strong> (<code>if</code>). Fill in the input fields and watch the results update live.</p>",
          "iframeHeight": 110
        },
        {
          "id": "section-date",
          "fieldType": "section",
          "title": "1 — Date Arithmetic",
          "fields": [
            {
              "id": "start-date",
              "fieldType": "text",
              "question": "Start Date",
              "inputType": "date",
              "required": true
            },
            {
              "id": "end-date",
              "fieldType": "text",
              "question": "End Date",
              "inputType": "date",
              "required": true
            },
            {
              "id": "date-results",
              "fieldType": "display",
              "content": "**14 days after start:** <addDays({start-date}, 14)>\n\n**7 days before start:** <subDays({start-date}, 7)>\n\n**Days between start → end:** <diffDays({end-date}, {start-date})>\n\n**Year of start date:** <year({start-date})>\n\n**Today:** <today()>",
              "rules": [
                {
                  "effect": "visible",
                  "logic": "AND",
                  "conditions": [
                    {
                      "conditionType": "expression",
                      "expression": "{start-date} !== '' && {end-date} !== ''"
                    }
                  ]
                }
              ]
            },
            {
              "id": "date-gap-warning",
              "fieldType": "display",
              "content": "⚠️ End date is more than 30 days after start.",
              "rules": [
                {
                  "effect": "visible",
                  "logic": "AND",
                  "conditions": [
                    {
                      "conditionType": "expression",
                      "expression": "{start-date} !== '' && {end-date} !== '' && diffDays({end-date}, {start-date}) > 30"
                    }
                  ]
                }
              ]
            },
            {
              "id": "date-order-warning",
              "fieldType": "display",
              "content": "⚠️ End date is before start date.",
              "rules": [
                {
                  "effect": "visible",
                  "logic": "AND",
                  "conditions": [
                    {
                      "conditionType": "expression",
                      "expression": "{start-date} !== '' && {end-date} !== '' && diffDays({end-date}, {start-date}) < 0"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "section-today",
          "fieldType": "section",
          "title": "2 — today() Comparisons",
          "fields": [
            {
              "id": "event-date",
              "fieldType": "text",
              "question": "Event Date",
              "inputType": "date",
              "required": true
            },
            {
              "id": "event-timing",
              "fieldType": "display",
              "content": "**Days until/since event:** <diffDays({event-date}, today())>\n\n**Event year:** <year({event-date})>",
              "rules": [
                {
                  "effect": "visible",
                  "logic": "AND",
                  "conditions": [
                    {
                      "conditionType": "expression",
                      "expression": "{event-date} !== ''"
                    }
                  ]
                }
              ]
            },
            {
              "id": "event-past",
              "fieldType": "display",
              "content": "✅ This event is in the past.",
              "rules": [
                {
                  "effect": "visible",
                  "logic": "AND",
                  "conditions": [
                    {
                      "conditionType": "expression",
                      "expression": "{event-date} !== '' && diffDays({event-date}, today()) < 0"
                    }
                  ]
                }
              ]
            },
            {
              "id": "event-future",
              "fieldType": "display",
              "content": "📅 This event is in the future.",
              "rules": [
                {
                  "effect": "visible",
                  "logic": "AND",
                  "conditions": [
                    {
                      "conditionType": "expression",
                      "expression": "{event-date} !== '' && diffDays({event-date}, today()) > 0"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "section-numeric",
          "fieldType": "section",
          "title": "3 — Numeric Functions",
          "fields": [
            {
              "id": "num-a",
              "fieldType": "text",
              "question": "Number A",
              "inputType": "number"
            },
            {
              "id": "num-b",
              "fieldType": "text",
              "question": "Number B",
              "inputType": "number"
            },
            {
              "id": "num-c",
              "fieldType": "text",
              "question": "Number C",
              "inputType": "number"
            },
            {
              "id": "numeric-results",
              "fieldType": "display",
              "content": "**min(A, B, C):** <min({num-a}, {num-b}, {num-c})>\n\n**max(A, B, C):** <max({num-a}, {num-b}, {num-c})>\n\n**round(A / B):** <round({num-a} / {num-b})>\n\n**floor(A / B):** <floor({num-a} / {num-b})>\n\n**ceil(A / B):** <ceil({num-a} / {num-b})>\n\n**abs(A − B):** <abs({num-a} - {num-b})>",
              "rules": [
                {
                  "effect": "visible",
                  "logic": "AND",
                  "conditions": [
                    {
                      "conditionType": "expression",
                      "expression": "{num-a} !== '' && {num-b} !== '' && {num-c} !== '' && {num-b} !== 0"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "section-bmi",
          "fieldType": "section",
          "title": "4 — BMI Calculator (round + if)",
          "fields": [
            {
              "id": "weight-kg",
              "fieldType": "text",
              "question": "Weight",
              "inputType": "number",
              "unit": "kg",
              "required": true
            },
            {
              "id": "height-cm",
              "fieldType": "text",
              "question": "Height",
              "inputType": "number",
              "unit": "cm",
              "required": true
            },
            {
              "id": "bmi-result",
              "fieldType": "display",
              "content": "**BMI:** <round({weight-kg} / (({height-cm} / 100) * ({height-cm} / 100)))>\n\n**Category:** <if(round({weight-kg} / (({height-cm} / 100) * ({height-cm} / 100))) >= 30, 'Obese', if(round({weight-kg} / (({height-cm} / 100) * ({height-cm} / 100))) >= 25, 'Overweight', if(round({weight-kg} / (({height-cm} / 100) * ({height-cm} / 100))) >= 18.5, 'Normal weight', 'Underweight')))>",
              "rules": [
                {
                  "effect": "visible",
                  "logic": "AND",
                  "conditions": [
                    {
                      "conditionType": "expression",
                      "expression": "{weight-kg} > 0 && {height-cm} > 0"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {

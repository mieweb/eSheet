              "id": "num-c",
              "fieldType": "text",
              "question": "Number C",
              "inputType": "number"
            },
            {
              "id": "numeric-results",
              "fieldType": "display",
              "content": "**min(A, B, C):** \u003cmin({num-a}, {num-b}, {num-c})\u003e\n\n**max(A, B, C):** \u003cmax({num-a}, {num-b}, {num-c})\u003e\n\n**round(A / B):** \u003cround({num-a} / {num-b})\u003e\n\n**floor(A / B):** \u003cfloor({num-a} / {num-b})\u003e\n\n**ceil(A / B):** \u003cceil({num-a} / {num-b})\u003e\n\n**abs(A âˆ’ B):** \u003cabs({num-a} - {num-b})\u003e",
              "rules": [
                {
                  "effect": "visible",
                  "logic": "AND",
                  "conditions": [
                    {
                      "conditionType": "expression",
                      "expression": "{num-a} !== \u0027\u0027 \u0026\u0026 {num-b} !== \u0027\u0027 \u0026\u0026 {num-c} !== \u0027\u0027 \u0026\u0026 {num-b} !== 0"
                    }
                  ]
                }
              ]
            }
          ]
        },

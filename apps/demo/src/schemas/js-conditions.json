{
  "id": "js-conditions",
  "dangerouslyAllowJS": true,
  "title": "JS Conditions Test Suite",
  "pages": [
    {
      "id": "page-1",
      "fields": [
        {
          "id": "intro",
          "fieldType": "html",
          "htmlContent": "\u003ch2 style=\u0027margin:0 0 8px\u0027\u003eJS Conditions Test Suite\u003c/h2\u003e\u003cp\u003eTests every \u003ccode\u003econditionType: \u0027js\u0027\u003c/code\u003e pattern: comparisons, logical operators, string methods, regex, array checks, cross-field comparisons, and null guards. Fields in each section only appear when the JS condition passes.\u003c/p\u003e",
          "iframeHeight": 100
        },
        {
          "id": "section-comparisons",
          "fieldType": "section",
          "title": "1 â€” Simple Comparisons",
          "fields": [
            {
              "id": "cmp-number",
              "fieldType": "text",
              "question": "Enter a number (try values above/below 10, 18, 100)",
              "inputType": "number"
            },
            {
              "id": "cmp-gt10",
              "fieldType": "text",
              "question": "âœ“ Visible when number \u003e 10",
              "inputType": "string",
              "rules": [
                {
                  "effect": "visible",
                  "logic": "AND",
                  "conditions": [
                    {
                      "conditionType": "js",
                      "expression": "responses[\u0027cmp-number\u0027] \u003e 10"
                    }
                  ]
                }
              ]
            },
            {
              "id": "cmp-gte18",
              "fieldType": "text",
              "question": "âœ“ Visible when number \u003e= 18 (adult check)",
              "inputType": "string",
              "rules": [
                {
                  "effect": "visible",
                  "logic": "AND",
                  "conditions": [
                    {
                      "conditionType": "js",
                      "expression": "responses[\u0027cmp-number\u0027] \u003e= 18"
                    }
                  ]
                }
              ]
            },
            {
              "id": "cmp-range",
              "fieldType": "text",
              "question": "âœ“ Visible when number is between 10 and 20 inclusive",
              "inputType": "string",
              "rules": [
                {
                  "effect": "visible",
                  "logic": "AND",
                  "conditions": [
                    {
                      "conditionType": "js",
                      "expression": "responses[\u0027cmp-number\u0027] \u003e= 10 \u0026\u0026 responses[\u0027cmp-number\u0027] \u003c= 20"
                    }
                  ]
                }
              ]
            },
            {
              "id": "cmp-not100",
              "fieldType": "text",
              "question": "âœ“ Visible when number !== 100 (negation)",
              "inputType": "string",
              "rules": [
                {
                  "effect": "visible",
                  "logic": "AND",
                  "conditions": [
                    {
                      "conditionType": "js",
                      "expression": "responses[\u0027cmp-number\u0027] !== 100 \u0026\u0026 responses[\u0027cmp-number\u0027] !== \u0027\u0027"
                    }
                  ]
                }
              ]
            },
            {
              "id": "cmp-abs",
              "fieldType": "text",
              "question": "âœ“ Visible when |number| \u003e 50 (Math.abs check)",
              "inputType": "string",
              "rules": [
                {
                  "effect": "visible",
                  "logic": "AND",
                  "conditions": [
                    {
                      "conditionType": "js",
                      "expression": "Math.abs(responses[\u0027cmp-number\u0027] || 0) \u003e 50"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "section-strings",
          "fieldType": "section",
          "title": "2 â€” String Method Conditions",
          "fields": [
            {
              "id": "str-input",
              "fieldType": "text",
              "question": "Enter some text (try \u0027hello world\u0027, \u0027test@email.com\u0027, \u0027MR SMITH\u0027)",
              "inputType": "string"
            },
            {
              "id": "str-includes",
              "fieldType": "text",
              "question": "âœ“ Visible when input includes \u0027world\u0027",
              "inputType": "string",
              "rules": [
                {
                  "effect": "visible",
                  "logic": "AND",
                  "conditions": [
                    {
                      "conditionType": "js",
                      "expression": "typeof responses[\u0027str-input\u0027] === \u0027string\u0027 \u0026\u0026 responses[\u0027str-input\u0027].includes(\u0027world\u0027)"
                    }
                  ]
                }
              ]
            },
            {
              "id": "str-startswith",
              "fieldType": "text",
              "question": "âœ“ Visible when input starts with \u0027hello\u0027",
              "inputType": "string",
              "rules": [
                {
                  "effect": "visible",
                  "logic": "AND",
                  "conditions": [
                    {
                      "conditionType": "js",
                      "expression": "typeof responses[\u0027str-input\u0027] === \u0027string\u0027 \u0026\u0026 responses[\u0027str-input\u0027].toLowerCase().startsWith(\u0027hello\u0027)"
                    }
                  ]
                }
              ]
            },
            {
              "id": "str-endswith",
              "fieldType": "text",
              "question": "âœ“ Visible when input ends with \u0027.com\u0027",
              "inputType": "string",
              "rules": [
                {
                  "effect": "visible",
                  "logic": "AND",
                  "conditions": [
                    {
                      "conditionType": "js",
                      "expression": "typeof responses[\u0027str-input\u0027] === \u0027string\u0027 \u0026\u0026 responses[\u0027str-input\u0027].endsWith(\u0027.com\u0027)"
                    }
                  ]
                }
              ]
            },
            {
              "id": "str-length",
              "fieldType": "text",
              "question": "âœ“ Visible when input is longer than 10 characters",
              "inputType": "string",
              "rules": [
                {
                  "effect": "visible",
                  "logic": "AND",
                  "conditions": [
                    {
                      "conditionType": "js",
                      "expression": "typeof responses[\u0027str-input\u0027] === \u0027string\u0027 \u0026\u0026 responses[\u0027str-input\u0027].length \u003e 10"
                    }
                  ]
                }
              ]
            },
            {
              "id": "str-upper",
              "fieldType": "text",
              "question": "âœ“ Visible when input is ALL UPPERCASE",
              "inputType": "string",
              "rules": [
                {
                  "effect": "visible",
                  "logic": "AND",
                  "conditions": [
                    {
                      "conditionType": "js",
                      "expression": "typeof responses[\u0027str-input\u0027] === \u0027string\u0027 \u0026\u0026 responses[\u0027str-input\u0027].trim().length \u003e 0 \u0026\u0026 responses[\u0027str-input\u0027] === responses[\u0027str-input\u0027].toUpperCase()"
                    }
                  ]
                }
              ]
            },
            {
              "id": "str-regex-email",
              "fieldType": "text",
              "question": "âœ“ Visible when input looks like an email (regex)",
              "inputType": "string",
              "rules": [
                {
                  "effect": "visible",
                  "logic": "AND",
                  "conditions": [
                    {
                      "conditionType": "js",
                      "expression": "/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(responses[\u0027str-input\u0027] || \u0027\u0027)"
                    }
                  ]
                }
              ]
            },
            {
              "id": "str-regex-zip",
              "fieldType": "text",
              "question": "âœ“ Visible when input is a 5-digit US ZIP code",
              "inputType": "string",
              "rules": [
                {
                  "effect": "visible",
                  "logic": "AND",
                  "conditions": [
                    {
                      "conditionType": "js",
                      "expression": "/^[0-9]{5}$/.test(responses[\u0027str-input\u0027] || \u0027\u0027)"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "section-logic",
          "fieldType": "section",
          "title": "3 â€” Logical Operators (AND / OR / NOT)",
          "fields": [
            {
              "id": "logic-p",
              "fieldType": "text",
              "question": "Value P (number)",
              "inputType": "number"
            },
            {
              "id": "logic-q",
              "fieldType": "text",
              "question": "Value Q (number)",
              "inputType": "number"
            },
            {
              "id": "logic-and",
              "fieldType": "text",
              "question": "âœ“ Visible when P \u003e 5 AND Q \u003e 5",
              "inputType": "string",
              "rules": [
                {
                  "effect": "visible",
                  "logic": "AND",
                  "conditions": [
                    {
                      "conditionType": "js",
                      "expression": "responses[\u0027logic-p\u0027] \u003e 5 \u0026\u0026 responses[\u0027logic-q\u0027] \u003e 5"
                    }
                  ]
                }
              ]
            },
            {
              "id": "logic-or",
              "fieldType": "text",
              "question": "âœ“ Visible when P \u003e 5 OR Q \u003e 5",
              "inputType": "string",
              "rules": [
                {
                  "effect": "visible",
                  "logic": "AND",
                  "conditions": [
                    {
                      "conditionType": "js",
                      "expression": "responses[\u0027logic-p\u0027] \u003e 5 || responses[\u0027logic-q\u0027] \u003e 5"
                    }
                  ]
                }
              ]
            },
            {
              "id": "logic-not",
              "fieldType": "text",
              "question": "âœ“ Visible when NOT (P === Q)",
              "inputType": "string",
              "rules": [
                {
                  "effect": "visible",
                  "logic": "AND",
                  "conditions": [
                    {
                      "conditionType": "js",
                      "expression": "!(responses[\u0027logic-p\u0027] === responses[\u0027logic-q\u0027]) \u0026\u0026 (responses[\u0027logic-p\u0027] !== \u0027\u0027 \u0026\u0026 responses[\u0027logic-q\u0027] !== \u0027\u0027)"
                    }
                  ]
                }
              ]
            },
            {
              "id": "logic-xor",
              "fieldType": "text",
              "question": "âœ“ Visible when exactly one of P, Q is \u003e 5 (XOR)",
              "inputType": "string",
              "rules": [
                {
                  "effect": "visible",
                  "logic": "AND",
                  "conditions": [
                    {
                      "conditionType": "js",
                      "expression": "(responses[\u0027logic-p\u0027] \u003e 5) !== (responses[\u0027logic-q\u0027] \u003e 5)"
                    }
                  ]
                }
              ]
            },
            {
              "id": "logic-complex",
              "fieldType": "text",
              "question": "âœ“ Visible when (P \u003e 0 AND Q \u003e 0) AND P + Q \u003e 20",
              "inputType": "string",
              "rules": [
                {
                  "effect": "visible",
                  "logic": "AND",
                  "conditions": [
                    {
                      "conditionType": "js",
                      "expression": "responses[\u0027logic-p\u0027] \u003e 0 \u0026\u0026 responses[\u0027logic-q\u0027] \u003e 0 \u0026\u0026 (responses[\u0027logic-p\u0027] + responses[\u0027logic-q\u0027]) \u003e 20"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "section-crossfield",
          "fieldType": "section",
          "title": "4 â€” Cross-Field Comparisons",
          "fields": [
            {
              "id": "cf-start",
              "fieldType": "text",
              "question": "Start value",
              "inputType": "number"
            },
            {
              "id": "cf-end",
              "fieldType": "text",
              "question": "End value",
              "inputType": "number"
            },
            {
              "id": "cf-valid-range",
              "fieldType": "text",
              "question": "âœ“ Visible when start \u003c end (valid range)",
              "inputType": "string",
              "rules": [
                {
                  "effect": "visible",
                  "logic": "AND",
                  "conditions": [
                    {
                      "conditionType": "js",
                      "expression": "responses[\u0027cf-start\u0027] !== \u0027\u0027 \u0026\u0026 responses[\u0027cf-end\u0027] !== \u0027\u0027 \u0026\u0026 Number(responses[\u0027cf-start\u0027]) \u003c Number(responses[\u0027cf-end\u0027])"
                    }
                  ]
                }
              ]
            },
            {
              "id": "cf-equal",
              "fieldType": "text",
              "question": "âœ“ Visible when start === end",
              "inputType": "string",
              "rules": [
                {
                  "effect": "visible",
                  "logic": "AND",
                  "conditions": [
                    {
                      "conditionType": "js",
                      "expression": "responses[\u0027cf-start\u0027] !== \u0027\u0027 \u0026\u0026 responses[\u0027cf-end\u0027] !== \u0027\u0027 \u0026\u0026 Number(responses[\u0027cf-start\u0027]) === Number(responses[\u0027cf-end\u0027])"
                    }
                  ]
                }
              ]
            },
            {
              "id": "cf-diff-big",
              "fieldType": "text",
              "question": "âœ“ Visible when |end âˆ’ start| \u003e 100",
              "inputType": "string",
              "rules": [
                {
                  "effect": "visible",
                  "logic": "AND",
                  "conditions": [
                    {
                      "conditionType": "js",
                      "expression": "Math.abs((responses[\u0027cf-end\u0027] || 0) - (responses[\u0027cf-start\u0027] || 0)) \u003e 100"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "section-nullguard",
          "fieldType": "section",
          "title": "5 â€” Null / Empty Guards",
          "fields": [
            {
              "id": "ng-optional",
              "fieldType": "text",
              "question": "Optional field (leave blank to test null guard paths)",
              "inputType": "string"
            },
            {
              "id": "ng-truthy",
              "fieldType": "text",
              "question": "âœ“ Visible when optional field is truthy (non-empty)",
              "inputType": "string",
              "rules": [
                {
                  "effect": "visible",
                  "logic": "AND",
                  "conditions": [
                    {
                      "conditionType": "js",
                      "expression": "!!responses[\u0027ng-optional\u0027]"
                    }
                  ]
                }
              ]
            },
            {
              "id": "ng-empty",
              "fieldType": "text",
              "question": "âœ“ Visible when optional field IS empty",
              "inputType": "string",
              "rules": [
                {
                  "effect": "visible",
                  "logic": "AND",
                  "conditions": [
                    {
                      "conditionType": "js",
                      "expression": "!responses[\u0027ng-optional\u0027] || responses[\u0027ng-optional\u0027] === \u0027\u0027"
                    }
                  ]
                }
              ]
            },
            {
              "id": "ng-bad-js",
              "fieldType": "text",
              "question": "âœ“ This field has BROKEN JS condition â€” should stay hidden (graceful fail)",
              "inputType": "string",
              "rules": [
                {
                  "effect": "visible",
                  "logic": "AND",
                  "conditions": [
                    {
                      "conditionType": "js",
                      "expression": "undefined_object.property.nested"
                    }
                  ]
                }
              ]
            },
            {
              "id": "ng-throw",
              "fieldType": "text",
              "question": "âœ“ This field throws inside JS â€” should stay hidden (graceful fail)",
              "inputType": "string",
              "rules": [
                {
                  "effect": "visible",
                  "logic": "AND",
                  "conditions": [
                    {
                      "conditionType": "js",
                      "expression": "(function(){ throw new Error(\u0027deliberate\u0027); })()"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "section-array",
          "fieldType": "section",
          "title": "6 â€” Array / Inclusion Checks",
          "fields": [
            {
              "id": "arr-choice",
              "fieldType": "radio",
              "question": "Choose a category",
              "options": [
                {
                  "id": "arr-c-alpha",
                  "value": "alpha",
                  "text": "Alpha"
                },
                {
                  "id": "arr-c-beta",
                  "value": "beta",
                  "text": "Beta"
                },
                {
                  "id": "arr-c-gamma",
                  "value": "gamma",
                  "text": "Gamma"
                },
                {
                  "id": "arr-c-delta",
                  "value": "delta",
                  "text": "Delta"
                }
              ]
            },
            {
              "id": "arr-in-set",
              "fieldType": "text",
              "question": "âœ“ Visible when choice is Alpha or Beta (Array.includes)",
              "inputType": "string",
              "rules": [
                {
                  "effect": "visible",
                  "logic": "AND",
                  "conditions": [
                    {
                      "conditionType": "js",
                      "expression": "[\u0027alpha\u0027, \u0027beta\u0027].includes(responses[\u0027arr-choice\u0027])"
                    }
                  ]
                }
              ]
            },
            {
              "id": "arr-not-in-set",
              "fieldType": "text",
              "question": "âœ“ Visible when choice is NOT in [alpha, gamma]",
              "inputType": "string",
              "rules": [
                {
                  "effect": "visible",
                  "logic": "AND",
                  "conditions": [
                    {
                      "conditionType": "js",
                      "expression": "![\u0027alpha\u0027, \u0027gamma\u0027].includes(responses[\u0027arr-choice\u0027])"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "section-effects",
          "fieldType": "section",
          "title": "7 â€” All Three Effects (visible / enable / required)",
          "fields": [
            {
              "id": "eff-gate",
              "fieldType": "slider",
              "question": "Gate value (0â€“10)",
              "options": [
                {
                  "id": "eff-g-0",
                  "value": "0",
                  "score": 0
                },
                {
                  "id": "eff-g-1",
                  "value": "1",
                  "score": 1
                },
                {
                  "id": "eff-g-2",
                  "value": "2",
                  "score": 2
                },
                {
                  "id": "eff-g-3",
                  "value": "3",
                  "score": 3
                },
                {
                  "id": "eff-g-4",
                  "value": "4",
                  "score": 4
                },
                {
                  "id": "eff-g-5",
                  "value": "5",
                  "score": 5
                },
                {
                  "id": "eff-g-6",
                  "value": "6",
                  "score": 6
                },
                {
                  "id": "eff-g-7",
                  "value": "7",
                  "score": 7
                },
                {
                  "id": "eff-g-8",
                  "value": "8",
                  "score": 8
                },
                {
                  "id": "eff-g-9",
                  "value": "9",
                  "score": 9
                },
                {
                  "id": "eff-g-10",
                  "value": "10",
                  "score": 10
                }
              ]
            },
            {
              "id": "eff-visible",
              "fieldType": "text",
              "question": "effect: visible â€” shown only when gate \u003e 3",
              "inputType": "string",
              "rules": [
                {
                  "effect": "visible",
                  "logic": "AND",
                  "conditions": [
                    {
                      "conditionType": "js",
                      "expression": "responses[\u0027eff-gate\u0027] \u003e 3"
                    }
                  ]
                }
              ]
            },
            {
              "id": "eff-enabled",
              "fieldType": "text",
              "question": "effect: enable â€” interactive only when gate \u003e 6 (otherwise disabled)",
              "inputType": "string",
              "rules": [
                {
                  "effect": "enable",
                  "logic": "AND",
                  "conditions": [
                    {
                      "conditionType": "js",
                      "expression": "responses[\u0027eff-gate\u0027] \u003e 6"
                    }
                  ]
                }
              ]
            },
            {
              "id": "eff-required",
              "fieldType": "text",
              "question": "effect: required â€” mandatory when gate === 10",
              "inputType": "string",
              "rules": [
                {
                  "effect": "required",
                  "logic": "AND",
                  "conditions": [
                    {
                      "conditionType": "js",
                      "expression": "responses[\u0027eff-gate\u0027] === 10"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}

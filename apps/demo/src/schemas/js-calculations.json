        {
          "id": "intro",
          "fieldType": "html",
          "htmlContent": "\u003ch2 style=\u0027margin:0 0 8px\u0027\u003eJS Calculations Test Suite\u003c/h2\u003e\u003cp\u003eTests every \u003ccode\u003ecalculation\u003c/code\u003e pattern: arithmetic, strings, ternary, Math helpers, aggregates, date math, and null-safety. All derived fields are \u003cem\u003eread-only output\u003c/em\u003e â€” fill in the input fields and watch them update live.\u003c/p\u003e",
          "iframeHeight": 100
        },
        {
          "id": "section-arithmetic",
          "fieldType": "section",
          "title": "1 â€” Basic Arithmetic",
          "fields": [
            {
              "id": "calc-a",
              "fieldType": "text",
              "question": "Number A",
              "inputType": "number"
            },
            {
              "id": "calc-b",
              "fieldType": "text",
              "question": "Number B",
              "inputType": "number"
            },
            {
              "id": "calc-sum",
              "fieldType": "text",
              "question": "Sum (A + B)",
              "inputType": "number",
              "calculation": "(responses[\u0027calc-a\u0027] || 0) + (responses[\u0027calc-b\u0027] || 0)"
            },
            {
              "id": "calc-diff",
              "fieldType": "text",
              "question": "Difference (A âˆ’ B)",
              "inputType": "number",
              "calculation": "(responses[\u0027calc-a\u0027] || 0) - (responses[\u0027calc-b\u0027] || 0)"
            },
            {
              "id": "calc-product",
              "fieldType": "text",
              "question": "Product (A Ã— B)",
              "inputType": "number",
              "calculation": "(responses[\u0027calc-a\u0027] || 0) * (responses[\u0027calc-b\u0027] || 0)"
            },
            {
              "id": "calc-quotient",
              "fieldType": "text",
              "question": "Quotient (A Ã· B) â€” safe divide",
              "inputType": "number",
              "calculation": "responses[\u0027calc-b\u0027] ? ((responses[\u0027calc-a\u0027] || 0) / responses[\u0027calc-b\u0027]).toFixed(4) : \u0027undefined\u0027"
            },
            {
              "id": "calc-modulo",
              "fieldType": "text",
              "question": "Modulo (A % B)",
              "inputType": "number",
              "calculation": "responses[\u0027calc-b\u0027] ? (responses[\u0027calc-a\u0027] || 0) % responses[\u0027calc-b\u0027] : \u0027\u0027"
            }
          ]
        },

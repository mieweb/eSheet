              "question": "Height (cm)",
              "inputType": "number"
            },
            {
              "id": "bmi-value",
              "fieldType": "text",
              "question": "BMI (weight / heightÂ²)",
              "inputType": "number",
              "calculation": "responses[\u0027bmi-height\u0027] ? (responses[\u0027bmi-weight\u0027] / Math.pow(responses[\u0027bmi-height\u0027] / 100, 2)).toFixed(1) : \u0027\u0027"
            },
            {
              "id": "bmi-category",
              "fieldType": "text",
              "question": "BMI Category",
              "inputType": "string",
              "calculation": "(function() { var bmi = responses[\u0027bmi-height\u0027] ? responses[\u0027bmi-weight\u0027] / Math.pow(responses[\u0027bmi-height\u0027] / 100, 2) : null; return bmi === null ? \u0027\u0027 : bmi \u003c 18.5 ? \u0027Underweight\u0027 : bmi \u003c 25 ? \u0027Normal\u0027 : bmi \u003c 30 ? \u0027Overweight\u0027 : \u0027Obese\u0027; })()"
            },
            {
              "id": "bmi-dob",
              "fieldType": "text",
              "question": "Date of birth",
              "inputType": "date"
            },
            {
              "id": "bmi-age",
              "fieldType": "text",
              "question": "Calculated age (years)",
              "inputType": "number",
              "calculation": "responses[\u0027bmi-dob\u0027] ? (new Date().getFullYear() - new Date(responses[\u0027bmi-dob\u0027]).getFullYear() - (new Date() \u003c new Date(new Date().getFullYear(), new Date(responses[\u0027bmi-dob\u0027]).getMonth(), new Date(responses[\u0027bmi-dob\u0027]).getDate()) ? 1 : 0)) : \u0027\u0027"
            }
          ]

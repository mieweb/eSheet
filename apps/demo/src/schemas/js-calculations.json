{
  "id": "js-calculations",
  "dangerouslyAllowJS": true,
  "title": "JS Calculations Test Suite",
  "fields": [
    {
      "id": "intro",
      "fieldType": "html",
      "htmlContent": "<h2 style='margin:0 0 8px'>JS Calculations Test Suite</h2><p>Tests every <code>calculation</code> pattern: arithmetic, strings, ternary, Math helpers, aggregates, date math, null-safety, and context data. All derived fields are <em>read-only output</em> — fill in the input fields and watch them update live.</p>",
      "iframeHeight": 100
    },
    {
      "id": "section-arithmetic",
      "fieldType": "section",
      "title": "1 — Basic Arithmetic",
      "fields": [
        {
          "id": "calc-a",
          "fieldType": "text",
          "question": "Number A",
          "inputType": "number"
        },
        {
          "id": "calc-b",
          "fieldType": "text",
          "question": "Number B",
          "inputType": "number"
        },
        {
          "id": "calc-sum",
          "fieldType": "text",
          "question": "Sum (A + B)",
          "inputType": "number",
          "calculation": "(responses['calc-a'] || 0) + (responses['calc-b'] || 0)"
        },
        {
          "id": "calc-diff",
          "fieldType": "text",
          "question": "Difference (A − B)",
          "inputType": "number",
          "calculation": "(responses['calc-a'] || 0) - (responses['calc-b'] || 0)"
        },
        {
          "id": "calc-product",
          "fieldType": "text",
          "question": "Product (A × B)",
          "inputType": "number",
          "calculation": "(responses['calc-a'] || 0) * (responses['calc-b'] || 0)"
        },
        {
          "id": "calc-quotient",
          "fieldType": "text",
          "question": "Quotient (A ÷ B) — safe divide",
          "inputType": "number",
          "calculation": "responses['calc-b'] ? ((responses['calc-a'] || 0) / responses['calc-b']).toFixed(4) : 'undefined'"
        },
        {
          "id": "calc-modulo",
          "fieldType": "text",
          "question": "Modulo (A % B)",
          "inputType": "number",
          "calculation": "responses['calc-b'] ? (responses['calc-a'] || 0) % responses['calc-b'] : ''"
        }
      ]
    },

    {
      "id": "section-math",
      "fieldType": "section",
      "title": "2 — Math Object Helpers",
      "fields": [
        {
          "id": "math-x",
          "fieldType": "text",
          "question": "Value X",
          "inputType": "number"
        },
        {
          "id": "math-y",
          "fieldType": "text",
          "question": "Value Y",
          "inputType": "number"
        },
        {
          "id": "math-abs",
          "fieldType": "text",
          "question": "Math.abs(X)",
          "inputType": "number",
          "calculation": "Math.abs(responses['math-x'] || 0)"
        },
        {
          "id": "math-round",
          "fieldType": "text",
          "question": "Math.round(X)",
          "inputType": "number",
          "calculation": "Math.round(responses['math-x'] || 0)"
        },
        {
          "id": "math-floor",
          "fieldType": "text",
          "question": "Math.floor(X)",
          "inputType": "number",
          "calculation": "Math.floor(responses['math-x'] || 0)"
        },
        {
          "id": "math-ceil",
          "fieldType": "text",
          "question": "Math.ceil(X)",
          "inputType": "number",
          "calculation": "Math.ceil(responses['math-x'] || 0)"
        },
        {
          "id": "math-pow",
          "fieldType": "text",
          "question": "Math.pow(X, Y)",
          "inputType": "number",
          "calculation": "Math.pow(responses['math-x'] || 0, responses['math-y'] || 1)"
        },
        {
          "id": "math-sqrt",
          "fieldType": "text",
          "question": "Math.sqrt(X)",
          "inputType": "number",
          "calculation": "(responses['math-x'] || 0) >= 0 ? Math.sqrt(responses['math-x'] || 0).toFixed(6) : 'imaginary'"
        },
        {
          "id": "math-max",
          "fieldType": "text",
          "question": "Math.max(X, Y)",
          "inputType": "number",
          "calculation": "Math.max(responses['math-x'] || 0, responses['math-y'] || 0)"
        },
        {
          "id": "math-min",
          "fieldType": "text",
          "question": "Math.min(X, Y)",
          "inputType": "number",
          "calculation": "Math.min(responses['math-x'] || 0, responses['math-y'] || 0)"
        }
      ]
    },

    {
      "id": "section-aggregate",
      "fieldType": "section",
      "title": "3 — Multi-Field Aggregation",
      "fields": [
        {
          "id": "agg-q1",
          "fieldType": "slider",
          "question": "Score 1",
          "options": [
            { "id": "agg-q1-0", "value": "0", "score": 0 },
            { "id": "agg-q1-1", "value": "1", "score": 1 },
            { "id": "agg-q1-2", "value": "2", "score": 2 },
            { "id": "agg-q1-3", "value": "3", "score": 3 },
            { "id": "agg-q1-4", "value": "4", "score": 4 },
            { "id": "agg-q1-5", "value": "5", "score": 5 },
            { "id": "agg-q1-6", "value": "6", "score": 6 },
            { "id": "agg-q1-7", "value": "7", "score": 7 },
            { "id": "agg-q1-8", "value": "8", "score": 8 },
            { "id": "agg-q1-9", "value": "9", "score": 9 },
            { "id": "agg-q1-10", "value": "10", "score": 10 }
          ]
        },
        {
          "id": "agg-q2",
          "fieldType": "slider",
          "question": "Score 2",
          "options": [
            { "id": "agg-q2-0", "value": "0", "score": 0 },
            { "id": "agg-q2-1", "value": "1", "score": 1 },
            { "id": "agg-q2-2", "value": "2", "score": 2 },
            { "id": "agg-q2-3", "value": "3", "score": 3 },
            { "id": "agg-q2-4", "value": "4", "score": 4 },
            { "id": "agg-q2-5", "value": "5", "score": 5 },
            { "id": "agg-q2-6", "value": "6", "score": 6 },
            { "id": "agg-q2-7", "value": "7", "score": 7 },
            { "id": "agg-q2-8", "value": "8", "score": 8 },
            { "id": "agg-q2-9", "value": "9", "score": 9 },
            { "id": "agg-q2-10", "value": "10", "score": 10 }
          ]
        },
        {
          "id": "agg-q3",
          "fieldType": "slider",
          "question": "Score 3",
          "options": [
            { "id": "agg-q3-0", "value": "0", "score": 0 },
            { "id": "agg-q3-1", "value": "1", "score": 1 },
            { "id": "agg-q3-2", "value": "2", "score": 2 },
            { "id": "agg-q3-3", "value": "3", "score": 3 },
            { "id": "agg-q3-4", "value": "4", "score": 4 },
            { "id": "agg-q3-5", "value": "5", "score": 5 },
            { "id": "agg-q3-6", "value": "6", "score": 6 },
            { "id": "agg-q3-7", "value": "7", "score": 7 },
            { "id": "agg-q3-8", "value": "8", "score": 8 },
            { "id": "agg-q3-9", "value": "9", "score": 9 },
            { "id": "agg-q3-10", "value": "10", "score": 10 }
          ]
        },
        {
          "id": "agg-q4",
          "fieldType": "slider",
          "question": "Score 4",
          "options": [
            { "id": "agg-q4-0", "value": "0", "score": 0 },
            { "id": "agg-q4-1", "value": "1", "score": 1 },
            { "id": "agg-q4-2", "value": "2", "score": 2 },
            { "id": "agg-q4-3", "value": "3", "score": 3 },
            { "id": "agg-q4-4", "value": "4", "score": 4 },
            { "id": "agg-q4-5", "value": "5", "score": 5 },
            { "id": "agg-q4-6", "value": "6", "score": 6 },
            { "id": "agg-q4-7", "value": "7", "score": 7 },
            { "id": "agg-q4-8", "value": "8", "score": 8 },
            { "id": "agg-q4-9", "value": "9", "score": 9 },
            { "id": "agg-q4-10", "value": "10", "score": 10 }
          ]
        },
        {
          "id": "agg-total",
          "fieldType": "text",
          "question": "Total (sum of all 4 scores)",
          "inputType": "number",
          "calculation": "(responses['agg-q1'] || 0) + (responses['agg-q2'] || 0) + (responses['agg-q3'] || 0) + (responses['agg-q4'] || 0)"
        },
        {
          "id": "agg-average",
          "fieldType": "text",
          "question": "Average (mean of all 4 scores)",
          "inputType": "number",
          "calculation": "((responses['agg-q1'] || 0) + (responses['agg-q2'] || 0) + (responses['agg-q3'] || 0) + (responses['agg-q4'] || 0)) / 4"
        },
        {
          "id": "agg-percent",
          "fieldType": "text",
          "question": "Percent of max (40 pts)",
          "inputType": "string",
          "calculation": "(((responses['agg-q1'] || 0) + (responses['agg-q2'] || 0) + (responses['agg-q3'] || 0) + (responses['agg-q4'] || 0)) / 40 * 100).toFixed(1) + '%'"
        },
        {
          "id": "agg-severity",
          "fieldType": "text",
          "question": "Severity label (chained ternary)",
          "inputType": "string",
          "calculation": "(function() { var t = (responses['agg-q1'] || 0) + (responses['agg-q2'] || 0) + (responses['agg-q3'] || 0) + (responses['agg-q4'] || 0); return t >= 30 ? 'Severe' : t >= 20 ? 'Moderate' : t >= 10 ? 'Mild' : 'Minimal'; })()"
        }
      ]
    },

    {
      "id": "section-health",
      "fieldType": "section",
      "title": "4 — Health Metrics (BMI / Age)",
      "fields": [
        {
          "id": "bmi-weight",
          "fieldType": "text",
          "question": "Weight (kg)",
          "inputType": "number"
        },
        {
          "id": "bmi-height",
          "fieldType": "text",
          "question": "Height (cm)",
          "inputType": "number"
        },
        {
          "id": "bmi-value",
          "fieldType": "text",
          "question": "BMI (weight / height²)",
          "inputType": "number",
          "calculation": "responses['bmi-height'] ? (responses['bmi-weight'] / Math.pow(responses['bmi-height'] / 100, 2)).toFixed(1) : ''"
        },
        {
          "id": "bmi-category",
          "fieldType": "text",
          "question": "BMI Category",
          "inputType": "string",
          "calculation": "(function() { var bmi = responses['bmi-height'] ? responses['bmi-weight'] / Math.pow(responses['bmi-height'] / 100, 2) : null; return bmi === null ? '' : bmi < 18.5 ? 'Underweight' : bmi < 25 ? 'Normal' : bmi < 30 ? 'Overweight' : 'Obese'; })()"
        },
        {
          "id": "bmi-dob",
          "fieldType": "text",
          "question": "Date of birth",
          "inputType": "date"
        },
        {
          "id": "bmi-age",
          "fieldType": "text",
          "question": "Calculated age (years)",
          "inputType": "number",
          "calculation": "responses['bmi-dob'] ? (new Date().getFullYear() - new Date(responses['bmi-dob']).getFullYear() - (new Date() < new Date(new Date().getFullYear(), new Date(responses['bmi-dob']).getMonth(), new Date(responses['bmi-dob']).getDate()) ? 1 : 0)) : ''"
        }
      ]
    },

    {
      "id": "section-strings",
      "fieldType": "section",
      "title": "5 — String Calculations",
      "fields": [
        {
          "id": "str-first",
          "fieldType": "text",
          "question": "First name",
          "inputType": "string"
        },
        {
          "id": "str-last",
          "fieldType": "text",
          "question": "Last name",
          "inputType": "string"
        },
        {
          "id": "str-full",
          "fieldType": "text",
          "question": "Full name (concatenated)",
          "inputType": "string",
          "calculation": "((responses['str-first'] || '').trim() + ' ' + (responses['str-last'] || '').trim()).trim()"
        },
        {
          "id": "str-initials",
          "fieldType": "text",
          "question": "Initials",
          "inputType": "string",
          "calculation": "[(responses['str-first'] || '')[0], (responses['str-last'] || '')[0]].filter(Boolean).join('').toUpperCase()"
        },
        {
          "id": "str-upper",
          "fieldType": "text",
          "question": "Last name UPPER",
          "inputType": "string",
          "calculation": "(responses['str-last'] || '').toUpperCase()"
        },
        {
          "id": "str-length",
          "fieldType": "text",
          "question": "Full name character count",
          "inputType": "number",
          "calculation": "((responses['str-first'] || '').trim() + ' ' + (responses['str-last'] || '').trim()).trim().length || 0"
        },
        {
          "id": "str-greeting",
          "fieldType": "text",
          "question": "Greeting (template literal style)",
          "inputType": "string",
          "calculation": "responses['str-first'] ? 'Hello, ' + responses['str-first'] + '!' : ''"
        }
      ]
    },

    {
      "id": "section-nullsafe",
      "fieldType": "section",
      "title": "6 — Null / Edge-Case Safety",
      "fields": [
        {
          "id": "ns-maybe",
          "fieldType": "text",
          "question": "Optional number (leave blank to test null path)",
          "inputType": "number"
        },
        {
          "id": "ns-defaulted",
          "fieldType": "text",
          "question": "Value || 0 (null-coalescing fallback)",
          "inputType": "number",
          "calculation": "responses['ns-maybe'] || 0"
        },
        {
          "id": "ns-doubled",
          "fieldType": "text",
          "question": "Value × 2 (safe — blank stays blank)",
          "inputType": "string",
          "calculation": "responses['ns-maybe'] !== '' && responses['ns-maybe'] != null ? responses['ns-maybe'] * 2 : ''"
        },
        {
          "id": "ns-bad-js",
          "fieldType": "text",
          "question": "Intentionally broken JS (should show empty, not crash)",
          "inputType": "string",
          "calculation": "this_variable_does_not_exist.foo.bar"
        },
        {
          "id": "ns-infinity",
          "fieldType": "text",
          "question": "Division by zero guard",
          "inputType": "string",
          "calculation": "var v = responses['ns-maybe']; (v === 0 || v === '0') ? 'Cannot divide by zero' : v ? (100 / v).toFixed(4) : ''"
        }
      ]
    }
  ]
}

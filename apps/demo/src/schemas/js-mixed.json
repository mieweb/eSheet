              "id": "bmi-height",
              "fieldType": "text",
              "question": "Height (cm)",
              "inputType": "number"
            },
            {
              "id": "bmi-result",
              "fieldType": "text",
              "question": "Calculated BMI",
              "inputType": "number",
              "calculation": "responses[\u0027bmi-height\u0027] ? (responses[\u0027bmi-weight\u0027] / Math.pow(responses[\u0027bmi-height\u0027] / 100, 2)).toFixed(1) : \u0027\u0027"
            },
            {
              "id": "bmi-under",
              "fieldType": "text",
              "question": "âœ“ Underweight guidance â€” shown when BMI \u003c 18.5",
              "inputType": "string",
              "rules": [
                {
                  "effect": "visible",
                  "logic": "AND",
                  "conditions": [
                    {
                      "conditionType": "js",
                      "expression": "responses[\u0027bmi-result\u0027] !== \u0027\u0027 \u0026\u0026 Number(responses[\u0027bmi-result\u0027]) \u003c 18.5"
                    }
                  ]
                }
              ]
            },
            {
              "id": "bmi-normal",
              "fieldType": "text",
              "question": "âœ“ Normal range note â€” shown when 18.5 â‰¤ BMI \u003c 25",
              "inputType": "string",

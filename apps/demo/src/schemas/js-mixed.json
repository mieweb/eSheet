            },
            {
              "id": "pipe-label",
              "fieldType": "text",
              "question": "Derived severity label (calculation on total)",
              "inputType": "string",
              "calculation": "(function() { var t = (responses[\u0027pipe-q1\u0027] || 0) + (responses[\u0027pipe-q2\u0027] || 0) + (responses[\u0027pipe-q3\u0027] || 0); return t \u003e= 24 ? \u0027Severe\u0027 : t \u003e= 15 ? \u0027Moderate\u0027 : t \u003e= 7 ? \u0027Mild\u0027 : \u0027Minimal\u0027; })()"

            {
              "id": "evj-via-expression",
              "fieldType": "text",
              "question": "conditionType: expression — visible when slider > 5",
              "inputType": "string",
              "rules": [
                {
                  "effect": "visible",
                  "logic": "AND",
                  "conditions": [
                    {
                      "conditionType": "expression",
                      "expression": "{evj-slider} > 5"
                    }
                  ]
                }
              ]
            },
            {
              "id": "evj-via-js",
              "fieldType": "text",
              "question": "conditionType: js — visible when slider > 5 (same condition, JS variant)",
              "inputType": "string",
              "rules": [
                {
                  "effect": "visible",
                  "logic": "AND",
                  "conditions": [
                    {
                      "conditionType": "js",
                      "expression": "responses['evj-slider'] > 5"
                    }
                  ]
                }
              ]
            },
            {
              "id": "evj-note",
              "fieldType": "html",
              "htmlContent": "<p style='font-size:0.85rem;color:#666;margin:4px 0'>The two fields above should appear and disappear in sync — they implement identical logic via different condition types.</p>",
              "iframeHeight": 50
            }
          ]
        },
        {
          "id": "section-runtime-errors",
          "fieldType": "section",
          "title": "5 — Runtime Error Resilience",
          "fields": [
            {
              "id": "err-note",
              "fieldType": "html",
              "htmlContent": "<p style='font-size:0.85rem;color:#666;margin:4px 0'>All fields in this section have deliberately broken JS. None should be visible, and the form should not crash.</p>",
              "iframeHeight": 50
            },
            {
              "id": "err-cond-null-deref",
              "fieldType": "text",
              "question": "Hidden: null dereference in condition",
              "inputType": "string",
              "rules": [
                {
                  "effect": "visible",
                  "logic": "AND",
                  "conditions": [
                    {
                      "conditionType": "js",
                      "expression": "null.property"
                    }
                  ]
                }
              ]
            },
            {
              "id": "err-cond-syntax",
              "fieldType": "text",
              "question": "Hidden: syntax error in condition",
              "inputType": "string",
              "rules": [
                {
                  "effect": "visible",
                  "logic": "AND",
                  "conditions": [
                    {
                      "conditionType": "js",
                      "expression": "if (true) {{{"
                    }
                  ]
                }
              ]
            },
            {
              "id": "err-cond-throw",
              "fieldType": "text",
              "question": "Hidden: explicit throw in condition",
              "inputType": "string",
              "rules": [
                {
                  "effect": "visible",
                  "logic": "AND",
                  "conditions": [
                    {
                      "conditionType": "js",
                      "expression": "(function(){ throw 'oops'; })()"
                    }
                  ]
                }
              ]
            },
            {
              "id": "err-calc-bad",
              "fieldType": "text",
              "question": "Calculation: broken JS (should show empty string)",
              "inputType": "string",
              "calculation": "responses['nonexistent_field'].deeply.nested.value"
            },
            {
              "id": "err-calc-syntax",
              "fieldType": "text",
              "question": "Calculation: syntax error (should show empty string)",
              "inputType": "string",
              "calculation": "=== invalid syntax ==="
            }
          ]
        }
      ]
    }
  ]

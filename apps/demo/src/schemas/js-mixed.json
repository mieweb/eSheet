                  "effect": "visible",
                  "logic": "OR",
                  "conditions": [
                    {
                      "conditionType": "js",
                      "expression": "responses[\u0027mix-age\u0027] !== \u0027\u0027 \u0026\u0026 responses[\u0027mix-age\u0027] \u003c 18"
                    },
                    {
                      "conditionType": "field",
                      "targetId": "mix-consent",
                      "operator": "equals",
                      "expected": "no"
                    }
                  ]
                }
              ]
            }

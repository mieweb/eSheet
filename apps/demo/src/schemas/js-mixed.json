                  "conditions": [
                    {
                      "conditionType": "js",
                      "expression": "responses[\u0027mix-age\u0027] \u003e= 18"
                    },
                    {
                      "conditionType": "field",
                      "targetId": "mix-consent",
                      "operator": "equals",
                      "expected": "yes"
                    }
                  ]

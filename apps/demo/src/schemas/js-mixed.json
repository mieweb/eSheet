                }
              ]
            },
            {
              "id": "pipe-total",
              "fieldType": "text",
              "question": "Derived total score (calculation)",
              "inputType": "number",
              "calculation": "(responses['pipe-q1'] || 0) + (responses['pipe-q2'] || 0) + (responses['pipe-q3'] || 0)"
            },
            {
              "id": "pipe-label",
              "fieldType": "text",
              "question": "Derived severity label (calculation on total)",
              "inputType": "string",
              "calculation": "(function() { var t = (responses['pipe-q1'] || 0) + (responses['pipe-q2'] || 0) + (responses['pipe-q3'] || 0); return t >= 24 ? 'Severe' : t >= 15 ? 'Moderate' : t >= 7 ? 'Mild' : 'Minimal'; })()"
            },
            {
              "id": "pipe-referral",
              "fieldType": "text",
              "question": "✓ Referral note — visible when JS condition reads derived total > 15",
              "inputType": "string",
              "rules": [
                {
                  "effect": "visible",
                  "logic": "AND",
                  "conditions": [
                    {
                      "conditionType": "js",
                      "expression": "Number(responses['pipe-total']) > 15"
                    }
                  ]
                }
              ]
            },
            {
              "id": "pipe-crisis",
              "fieldType": "text",
              "question": "✓ Crisis protocol — visible when JS reads derived total >= 24",
              "inputType": "string",
              "rules": [
                {
                  "effect": "visible",
                  "logic": "AND",
                  "conditions": [
                    {
                      "conditionType": "js",
                      "expression": "Number(responses['pipe-total']) >= 24"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "section-bmi-branch",
          "fieldType": "section",
          "title": "2 — BMI Calculation → Conditional Branching",
          "fields": [
            {
              "id": "bmi-weight",
              "fieldType": "text",
              "question": "Weight (kg)",
              "inputType": "number"
            },
            {
              "id": "bmi-height",
              "fieldType": "text",
              "question": "Height (cm)",
              "inputType": "number"
            },
            {
              "id": "bmi-result",
              "fieldType": "text",
              "question": "Calculated BMI",
              "inputType": "number",
              "calculation": "responses['bmi-height'] ? (responses['bmi-weight'] / Math.pow(responses['bmi-height'] / 100, 2)).toFixed(1) : ''"
            },
            {
              "id": "bmi-under",
              "fieldType": "text",
              "question": "✓ Underweight guidance — shown when BMI < 18.5",
              "inputType": "string",
              "rules": [
                {
                  "effect": "visible",
                  "logic": "AND",
                  "conditions": [
                    {
                      "conditionType": "js",
                      "expression": "responses['bmi-result'] !== '' && Number(responses['bmi-result']) < 18.5"
                    }
                  ]
                }
              ]
            },
            {
              "id": "bmi-normal",
              "fieldType": "text",
              "question": "✓ Normal range note — shown when 18.5 ≤ BMI < 25",
              "inputType": "string",
              "rules": [
                {
                  "effect": "visible",
                  "logic": "AND",
                  "conditions": [
                    {
                      "conditionType": "js",
                      "expression": "responses['bmi-result'] !== '' && Number(responses['bmi-result']) >= 18.5 && Number(responses['bmi-result']) < 25"
                    }
                  ]
                }
              ]
            },
            {
              "id": "bmi-over",
              "fieldType": "text",
              "question": "✓ Overweight / obese follow-up — shown when BMI >= 25",
              "inputType": "string",
              "rules": [
                {
                  "effect": "visible",
                  "logic": "AND",
                  "conditions": [
                    {
                      "conditionType": "js",
                      "expression": "responses['bmi-result'] !== '' && Number(responses['bmi-result']) >= 25"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "section-mixed-rules",
          "fieldType": "section",
          "title": "3 — Mixed Rule Logic (JS + field condition in same rule)",
          "fields": [
            {
              "id": "mix-age",
              "fieldType": "text",
              "question": "Age",
              "inputType": "number"
            },
            {
              "id": "mix-consent",
              "fieldType": "boolean",
              "question": "I consent to participate",
              "options": [
                {
                  "id": "mix-consent-yes",
                  "value": "yes",
                  "text": "Yes"
                },
                {
                  "id": "mix-consent-no",
                  "value": "no",
                  "text": "No"
                }
              ]
            },
            {
              "id": "mix-adult-consent",
              "fieldType": "text",
              "question": "✓ Visible when BOTH: JS says age >= 18 AND field condition says consent = yes",
              "inputType": "string",
              "rules": [
                {
                  "effect": "visible",
                  "logic": "AND",
                  "conditions": [
                    {
                      "conditionType": "js",
                      "expression": "responses['mix-age'] >= 18"
                    },
                    {
                      "conditionType": "field",
                      "targetId": "mix-consent",
                      "operator": "equals",
                      "expected": "yes"
                    }
                  ]
                }
              ]
            },
            {
              "id": "mix-minor-or-noconsent",
              "fieldType": "text",
              "question": "✓ Visible when JS age < 18 OR field consent = no (OR logic)",
              "inputType": "string",
              "rules": [
                {
                  "effect": "visible",
                  "logic": "OR",
                  "conditions": [
                    {
                      "conditionType": "js",
                      "expression": "responses['mix-age'] !== '' && responses['mix-age'] < 18"
                    },
                    {
                      "conditionType": "field",
                      "targetId": "mix-consent",
                      "operator": "equals",
                      "expected": "no"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "section-expression-vs-js",
          "fieldType": "section",
          "title": "4 — Safe Expression vs. JS Condition (same logic, both types)",
          "fields": [
            {
              "id": "evj-slider",

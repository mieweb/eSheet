                  "logic": "AND",
                  "conditions": [
                    {
                      "conditionType": "js",
                      "expression": "responses[\u0027bmi-result\u0027] !== \u0027\u0027 \u0026\u0026 Number(responses[\u0027bmi-result\u0027]) \u003e= 18.5 \u0026\u0026 Number(responses[\u0027bmi-result\u0027]) \u003c 25"

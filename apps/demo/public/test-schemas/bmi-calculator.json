                {
                  "conditionType": "js",
                  "expression": "responses[\u0027height-cm\u0027] \u003e 0 \u0026\u0026 responses[\u0027weight-kg\u0027] \u003e 0 \u0026\u0026 (responses[\u0027weight-kg\u0027] / Math.pow(responses[\u0027height-cm\u0027] / 100, 2)) \u003c 18.5"
                }
              ]
            }
          ]
        },
        {
          "id": "bmi-normal",
          "fieldType": "display",
          "content": "âœ… Normal weight (BMI 18.5 â€“ 24.9)",
          "rules": [
            {
              "effect": "visible",
              "logic": "AND",
              "conditions": [
                {
                  "conditionType": "js",
                  "expression": "(function(){ var bmi = responses[\u0027weight-kg\u0027] / Math.pow(responses[\u0027height-cm\u0027] / 100, 2); return bmi \u003e= 18.5 \u0026\u0026 bmi \u003c 25; })()"
                }
              ]
            }
          ]
        },
        {
          "id": "bmi-overweight",
          "fieldType": "display",
          "content": "âš ï¸ Overweight (BMI 25 â€“ 29.9)",
          "rules": [
            {
              "effect": "visible",
              "logic": "AND",
              "conditions": [
                {
                  "conditionType": "js",
                  "expression": "(function(){ var bmi = responses[\u0027weight-kg\u0027] / Math.pow(responses[\u0027height-cm\u0027] / 100, 2); return bmi \u003e= 25 \u0026\u0026 bmi \u003c 30; })()"
                }
              ]
            }
          ]
        },
        {
          "id": "bmi-obese",
          "fieldType": "display",
          "content": "ðŸ”´ Obese (BMI â‰¥ 30)",
          "rules": [
            {
              "effect": "visible",

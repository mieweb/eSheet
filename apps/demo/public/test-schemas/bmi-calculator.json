{
  "id": "bmi-calculator",
  "title": "BMI Calculator",
  "dangerouslyAllowJS": true,
  "pages": [
    {
      "id": "page-1",
      "fields": [
        {
          "id": "intro",
          "fieldType": "display",
          "content": "Enter your height and weight below. BMI and category will be calculated automatically."
        },
        {
          "id": "height-cm",
          "fieldType": "text",
          "question": "Height (cm)",
          "required": false
        },
        {
          "id": "weight-kg",
          "fieldType": "text",
          "question": "Weight (kg)",
          "required": false
        },
        {
          "id": "bmi",
          "fieldType": "text",
          "question": "BMI (calculated)",
          "required": false,
          "calculation": "(responses[\u0027height-cm\u0027] \u003e 0 \u0026\u0026 responses[\u0027weight-kg\u0027] \u003e 0) ? String(Math.round((responses[\u0027weight-kg\u0027] / Math.pow(responses[\u0027height-cm\u0027] / 100, 2)) * 10) / 10) : \u0027\u0027",
          "rules": [
            {
              "effect": "visible",
              "logic": "AND",
              "conditions": [
                {
                  "conditionType": "js",
                  "expression": "responses[\u0027height-cm\u0027] \u003e 0 \u0026\u0026 responses[\u0027weight-kg\u0027] \u003e 0"
                }
              ]
            }
          ]
        },
        {
          "id": "bmi-category",
          "fieldType": "display",
          "content": "BMI Category",
          "rules": [
            {
              "effect": "visible",
              "logic": "AND",
              "conditions": [
                {
                  "conditionType": "js",
                  "expression": "responses[\u0027height-cm\u0027] \u003e 0 \u0026\u0026 responses[\u0027weight-kg\u0027] \u003e 0"
                }
              ]
            }
          ]
        },
        {
          "id": "bmi-underweight",
          "fieldType": "display",
          "content": "âš ï¸ Underweight (BMI \u003c 18.5)",

{
  "id": "ppd-reading",
  "title": "PPD (TB Skin Test) Reading",
  "dangerouslyAllowJS": true,
  "pages": [
    {
      "id": "page-1",
      "fields": [
        {
          "id": "ppd-date-tested",
          "fieldType": "text",
          "question": "Date PPD was placed (YYYY-MM-DD)",
          "required": false
        },
        {
          "id": "reading-window-open",
          "fieldType": "display",
          "content": "âœ… Reading window is open â€” the PPD can be read today (48â€“72 hours after placement).",
          "rules": [
            {
              "effect": "visible",
              "logic": "AND",
              "conditions": [
                {
                  "conditionType": "js",
                  "expression": "(function(){ var d = responses[\u0027ppd-date-tested\u0027]; if (!d || typeof d !== \u0027string\u0027) return false; var placed = new Date(d); if (isNaN(placed.getTime())) return false; var now = new Date(); var diffHours = (now - placed) / 3600000; return diffHours \u003e= 48 \u0026\u0026 diffHours \u003c= 72; })()"
                }
              ]
            }
          ]
        },
        {
          "id": "reading-window-closed",
          "fieldType": "display",
          "content": "âš ï¸ Outside the reading window â€” the PPD should be read between 48 and 72 hours after placement. Please contact your clinic.",
          "rules": [
            {
              "effect": "visible",
              "logic": "AND",
              "conditions": [
                {
                  "conditionType": "js",
                  "expression": "(function(){ var d = responses[\u0027ppd-date-tested\u0027]; if (!d || typeof d !== \u0027string\u0027 || d.trim() === \u0027\u0027) return false; var placed = new Date(d); if (isNaN(placed.getTime())) return false; var diffHours = (new Date() - placed) / 3600000; return diffHours \u003c 48 || diffHours \u003e 72; })()"
                }
              ]
            }
          ]
        },
        {
          "id": "induration-mm",
          "fieldType": "text",
          "question": "Induration size (mm)",
          "required": false,
          "rules": [
            {
              "effect": "visible",
              "logic": "AND",
              "conditions": [
                {
                  "conditionType": "js",
                  "expression": "(function(){ var d = responses[\u0027ppd-date-tested\u0027]; if (!d || typeof d !== \u0027string\u0027) return false; var placed = new Date(d); if (isNaN(placed.getTime())) return false; var diffHours = (new Date() - placed) / 3600000; return diffHours \u003e= 48 \u0026\u0026 diffHours \u003c= 72; })()"
                }
              ]
            }
          ]
        },
        {
          "id": "immune-status",
          "fieldType": "radio",
          "question": "Patient immune status",
          "required": false,
          "options": [
            {
              "id": "immune-normal",
              "value": "normal",
              "text": "Immunocompetent (healthy)"
            },
            {
              "id": "immune-hiv-low",
              "value": "hiv-low",
              "text": "HIV positive, CD4 â‰¥ 200"
            },
            {
              "id": "immune-hiv-high",
              "value": "hiv-high",
              "text": "HIV positive, CD4 \u003c 200 or unknown"
            },
            {
              "id": "immune-transplant",
              "value": "transplant",
              "text": "Organ transplant / TNF blocker / steroids"
            },
            {
              "id": "immune-close-contact",
              "value": "close-contact",
              "text": "Recent close TB contact or abnormal CXR"
            }
          ],
          "rules": [
            {
              "effect": "visible",
              "logic": "AND",
              "conditions": [
                {
                  "conditionType": "js",
                  "expression": "responses[\u0027induration-mm\u0027] !== \u0027\u0027 \u0026\u0026 responses[\u0027induration-mm\u0027] !== undefined"
                }
              ]
            }
          ]
        },
        {
          "id": "ppd-result",
          "fieldType": "text",
          "question": "Result (calculated)",
          "required": false,
          "calculation": "(function(){ var mm = responses[\u0027induration-mm\u0027]; var immune = responses[\u0027immune-status\u0027]; if (mm === \u0027\u0027 || mm === undefined || mm === null) return \u0027\u0027; var n = parseFloat(mm); if (isNaN(n)) return \u0027Invalid measurement\u0027; var threshold = 10; if (immune === \u0027hiv-high\u0027 || immune === \u0027transplant\u0027 || immune === \u0027close-contact\u0027) threshold = 5; else if (immune === \u0027hiv-low\u0027) threshold = 5; return n \u003e= threshold ? \u0027POSITIVE (\u0027 + n + \u0027 mm â€” threshold \u0027 + threshold + \u0027 mm)\u0027 : \u0027Negative (\u0027 + n + \u0027 mm â€” threshold \u0027 + threshold + \u0027 mm)\u0027; })()",
          "rules": [
            {
              "effect": "visible",
              "logic": "AND",
              "conditions": [
                {
                  "conditionType": "js",
                  "expression": "responses[\u0027induration-mm\u0027] !== \u0027\u0027 \u0026\u0026 responses[\u0027induration-mm\u0027] !== undefined \u0026\u0026 responses[\u0027immune-status\u0027] !== undefined"
                }
              ]
            }
          ]
        },
        {
          "id": "positive-followup",
          "fieldType": "display",
          "content": "ðŸ”´ Positive PPD â€” refer for chest X-ray and clinical evaluation per protocol.",
          "rules": [
            {
              "effect": "visible",
              "logic": "AND",
              "conditions": [
                {
                  "conditionType": "js",
                  "expression": "typeof responses[\u0027ppd-result\u0027] === \u0027string\u0027 \u0026\u0026 responses[\u0027ppd-result\u0027].startsWith(\u0027POSITIVE\u0027)"
                }
              ]
            }
          ]
        },
        {
          "id": "clinician-notes",
          "fieldType": "longtext",
          "question": "Clinician notes",
          "required": false
        }
      ]
    }
  ]
}

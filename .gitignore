dist
tmp
out-tsc
.nx/

# Kerebron WASM runtime assets (large binaries, not tracked in git)
apps/demo/public/kerebron-wasm/

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
nx-release-dryrun.log
*-dryrun.log
/typings

# System Files
.DS_Store
Thumbs.db


# env files
.env
.env.*

# TypeScript build info
*.tsbuildinfo

# CSS build outputs
**/src/index.output.css

# Workspace documentation and tickets (local only)
.github/workspace-doc/
/docs/SubAgent docs/

# Docusaurus generated artifacts
apps/docs/build/
apps/docs/.docusaurus/

# Kerebron WASM binaries — generated at dev/build time by kerebronWasmPlugin in vite.config.mts
apps/demo/public/kerebron-wasm/

vite.config.*.timestamp*
vitest.config.*.timestamp*
.claude/worktrees
.claude/settings.local.json


{
  "name": "@esheet/pdf",
  "version": "0.0.7-3",
  "description": "Generate fillable AcroForm PDFs from eSheet form definitions",
  "repository": {
    "type": "git",
    "url": "https://github.com/mieweb/eSheet"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@esheet/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "vite build",
    "lint": "eslint .",
    "test": "vitest",
    "typecheck": "tsc --build --emitDeclarationOnly"
  },
  "dependencies": {
    "@esheet/core": "workspace:*",
    "pdf-lib": "^1.17.1",
    "tslib": "^2.3.0"
  }
}

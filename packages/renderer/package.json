{
  "name": "@esheet/renderer",
  "version": "0.0.6-5",
  "repository": {
    "type": "git",
    "url": "https://github.com/mieweb/eSheet"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@esheet/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "prebuild": "pnpm build:css",
    "build": "vite build",
    "build:css": "tailwindcss -i src/index.css -o src/index.output.css",
    "build:css:watch": "tailwindcss -i src/index.css -o src/index.output.css --watch",
    "lint": "eslint .",
    "pretypecheck": "pnpm --filter @esheet/fields build",
    "test": "vitest",
    "typecheck": "tsc --build --emitDeclarationOnly --force"
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "@esheet/adapters": "workspace:*",
    "@esheet/core": "workspace:*",
    "@esheet/fields": "workspace:*",
    "js-yaml": "^5.2.3"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}

{
  "name": "@esheet/styles",
  "version": "0.0.6-9",
  "repository": {
    "type": "git",
    "url": "https://github.com/mieweb/eSheet"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@esheet/source": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": true,
  "scripts": {
    "prebuild": "pnpm build:css",
    "build": "vite build",
    "build:css": "tailwindcss -i src/index.css -o src/index.output.css",
    "build:css:watch": "tailwindcss -i src/index.css -o src/index.output.css --watch",
    "test": "node --test test/*.test.mjs"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.1"
  }
}

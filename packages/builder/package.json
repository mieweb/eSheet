{
  "name": "@esheet/builder",
  "version": "0.0.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/mieweb/eSheet"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@esheet/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build:css": "cd ../.. && npx @tailwindcss/cli -i packages/builder/src/index.css -o packages/builder/src/index.output.css",
    "build:css:watch": "cd ../.. && npx @tailwindcss/cli -i packages/builder/src/index.css -o packages/builder/src/index.output.css --watch"
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "tags": [
      "scope:builder"
    ]
  },
  "dependencies": {
    "@esheet/adapters": "0.0.2",
    "@esheet/core": "0.0.2",
    "@esheet/fields": "0.0.2",
    "@monaco-editor/react": "^4.7.0",
    "js-yaml": "^4.1.1",
    "react": "^19.2.4",
    "sortablejs": "^1.15.7",
    "tslib": "^2.3.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.1",
    "@testing-library/react": "^16.3.2",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4.2.1"
  }
}

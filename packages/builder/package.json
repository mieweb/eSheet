{
  "name": "@esheet/builder",
  "version": "0.0.6-7",
  "repository": {
    "type": "git",
    "url": "https://github.com/mieweb/eSheet"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@esheet/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": [
    "**/*.css",
    "./src/index.ts",
    "./dist/index.js"
  ],
  "scripts": {
    "build": "vite build",
    "lint": "eslint .",
    "pretypecheck": "pnpm --filter @esheet/fields build",
    "test": "vitest",
    "typecheck": "tsc --build --emitDeclarationOnly --force"
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "@esheet/adapters": "workspace:*",
    "@esheet/core": "workspace:*",
    "@esheet/fields": "workspace:*",
    "@esheet/styles": "workspace:*",
    "@mieweb/ui": "0.7.3",
    "@monaco-editor/react": "^4.7.0",
    "js-yaml": "^5.2.3",
    "react": "^19.2.4",
    "sortablejs": "^1.15.7",
    "tslib": "^2.3.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^29.1.1"
  }
}

{
  "name": "@esheet/fields",
  "version": "0.0.6",
  "repository": {
    "type": "git",
    "url": "https://github.com/mieweb/eSheet"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@esheet/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": [
    "**/*.css",
    "**/component-registry.ts",
    "**/component-registry.js"
  ],
  "scripts": {
    "prebuild": "pnpm build:css",
    "build": "vite build",
    "build:css": "tailwindcss -i src/index.css -o src/index.output.css",
    "build:css:watch": "tailwindcss -i src/index.css -o src/index.output.css --watch",
    "lint": "eslint .",
    "test": "vitest",
    "typecheck": "tsc --build --emitDeclarationOnly"
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "@esheet/core": "workspace:*",
    "@mieweb/ui": "0.7.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sortablejs": "^1.15.7",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3"
  }
}

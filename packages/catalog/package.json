{
  "name": "@esheet/catalog",
  "version": "0.0.6-17",
  "description": "MCDX catalog compiler, browser search runtime and standalone worker",
  "repository": {
    "type": "git",
    "url": "https://github.com/mieweb/eSheet"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@esheet/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "@esheet/source": "./src/runtime/index.ts",
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js",
      "default": "./dist/runtime/index.js"
    },
    "./worker": "./dist/catalog.worker.js",
    "./compiler": {
      "node": {
        "@esheet/source": "./src/compiler.ts",
        "types": "./dist/compiler.d.ts",
        "import": "./dist/compiler.js",
        "default": "./dist/compiler.js"
      }
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.lib.json && vite build --config vite.worker.config.ts",
    "typecheck": "tsc --project tsconfig.lib.json --noEmit --incremental false --composite false --declaration true && tsc --build tsconfig.spec.json --emitDeclarationOnly",
    "lint": "eslint .",
    "test": "pnpm run build && node --test test/*.test.mjs && vitest run"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "csv-parse": "^6.1.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.9"
  }
}

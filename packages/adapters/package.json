{
  "name": "@esheet/adapters",
  "version": "0.0.6-16",
  "description": "Convert external form schemas (SurveyJS, etc.) to eSheet FormDefinition",
  "repository": {
    "type": "git",
    "url": "https://github.com/mieweb/eSheet"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build tsconfig.lib.json",
    "lint": "eslint .",
    "test": "vitest",
    "typecheck": "tsc --build --emitDeclarationOnly"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@esheet/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./mdy": {
      "@esheet/source": "./src/lib/mdy.ts",
      "types": "./dist/lib/mdy.d.ts",
      "import": "./dist/lib/mdy.js",
      "default": "./dist/lib/mdy.js"
    },
    "./html": {
      "@esheet/source": "./src/lib/export-html.ts",
      "types": "./dist/lib/export-html.d.ts",
      "import": "./dist/lib/export-html.js",
      "default": "./dist/lib/export-html.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "@esheet/core": "workspace:*",
    "@mieweb/templit": "0.2.0",
    "handlebars": "^4.7.9",
    "js-yaml": "^5.2.3",
    "marked": "^16.3.0",
    "sanitize-html": "^2.18.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/sanitize-html": "^2.16.2",
    "vitest": "4.1.10"
  }
}

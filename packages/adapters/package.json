{
  "name": "@esheet/adapters",
  "version": "0.0.3",
  "description": "Convert external form schemas (SurveyJS, etc.) to eSheet FormDefinition",
  "repository": {
    "type": "git",
    "url": "https://github.com/mieweb/eSheet"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@esheet/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "tags": [
      "scope:adapters"
    ]
  },
  "dependencies": {
    "@esheet/core": "*",
    "tslib": "^2.3.0"
  },
  "devDependencies": {}
}

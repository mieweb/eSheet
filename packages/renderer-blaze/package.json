{
  "name": "@esheet/renderer-blaze",
  "version": "0.0.5",
  "repository": {
    "type": "git",
    "url": "https://github.com/mieweb/eSheet"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "lint": "eslint .",
    "typecheck": "tsc --build --emitDeclarationOnly"
  },
  "type": "module",
  "main": "./dist/blaze.js",
  "module": "./dist/blaze.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@esheet/source": "./src/index.tsx",
      "types": "./dist/index.d.ts",
      "import": "./dist/blaze.js",
      "default": "./dist/blaze.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "@esheet/renderer": "workspace:*",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tslib": "^2.3.0"
  }
}
